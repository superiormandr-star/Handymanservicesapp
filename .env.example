# Configure these in the deployment provider's private environment settings.
PORT=3000
DATA_FILE=/app/data/database.json
# ADMIN_TOKEN=GENERATE_A_LONG_RANDOM_SECRET_AND_KEEP_PRIVATE
# Keep off until pricing, staffing and fulfillment are agreed.
ESTIMATE_ASSISTANCE_ENABLED=false
# Microsoft authorization: exact deployed origin, no trailing slash.
# APP_ORIGIN=https://superior-proconnect.vercel.app
# MICROSOFT_TENANT_ID=enter_the_actual_Entra_tenant_ID
# MICROSOFT_CLIENT_ID=enter_the_actual_Entra_application_client_ID
# MICROSOFT_CLIENT_SECRET=configure_in_private_host_settings_only
# Existing lowercase microsoft_client_secret is also accepted; do not duplicate it.
# BACKUP_ENCRYPTION_KEY=64_hex_characters_from_a_secure_random_generator
# ONEDRIVE_STATE_DIR=/var/data/proconnect-microsoft
# ONEDRIVE_BACKUP_INTERVAL_MINUTES=60
