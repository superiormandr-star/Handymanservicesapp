# Configure these in the deployment provider's private environment settings.
PORT=3000
DATA_FILE=/app/data/database.json
# ADMIN_TOKEN=GENERATE_A_LONG_RANDOM_SECRET_AND_KEEP_PRIVATE
# Keep off until pricing, staffing and fulfillment are agreed.
ESTIMATE_ASSISTANCE_ENABLED=false

# Vercel private Blob primary storage. Select explicitly after record inventory.
SPC_STORAGE_BACKEND=blob
# Set securely in Vercel, never in public files:
BLOB_READ_WRITE_TOKEN=
BACKUP_ENCRYPTION_KEY=
# Must be unique and begin preview- for preview deployments:
# SPC_STORAGE_NAMESPACE=preview-repair
# Optional object path, restricted to superior-proconnect/<namespace>/
# SPC_BLOB_PATH=superior-proconnect/production/state.json.enc
# Keep both false until migration review and cross-deployment persistence test:
SPC_PERSISTENCE_VERIFIED=false
SPC_WRITES_ENABLED=false
APP_ORIGIN=https://superior-proconnect.vercel.app
CRON_SECRET=

# Netlify staging uses its own site and a stable preview namespace. Configure
# these in Netlify Functions environment settings. A production Netlify site
# explicitly uses SPC_STORAGE_NAMESPACE=production and SPC_NETLIFY_CONTEXT=production.
# SPC_STORAGE_BACKEND=netlify
# SPC_STORAGE_NAMESPACE=preview-staging
# SPC_NETLIFY_CONTEXT=deploy-preview
# SPC_NETLIFY_DATA_READY=false

# PayPal sandbox uses its own REST app, webhook and plan IDs.
# Enable only in a configured environment. See docs/netlify-launch.md.
PAYPAL_BILLING_ENABLED=false
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_PLAN_TERMS_JSON=
PAYPAL_HOSTED_FALLBACK_ENABLED=false
PAYPAL_ESTIMATE_REPORTS_ENABLED=false
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
